{
  "awaySummaryEnabled": false,
  "effortLevel": "xhigh",
  "enabledPlugins": {
    "context-mode@context-mode": true,
    "context7@claude-plugins-official": true,
    "mattpocock-skills@mattpocock": true,
    "pixijs-skills@pixijs-skills": true,
    "playwright@claude-plugins-official": true,
    "ponytail@ponytail": true
  },
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "extraKnownMarketplaces": {
    "context-mode": {
      "source": {
        "repo": "mksglu/context-mode",
        "source": "github"
      }
    },
    "mattpocock": {
      "source": {
        "repo": "mattpocock/skills",
        "source": "github"
      }
    },
    "pixijs-skills": {
      "source": {
        "repo": "pixijs/pixijs-skills",
        "source": "github"
      }
    },
    "ponytail": {
      "source": {
        "repo": "DietrichGebert/ponytail",
        "source": "github"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"/home/metsker/.claude/hooks/context-mode-cache-heal.mjs\"",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash '/home/metsker/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "spinnerTipsEnabled": false,
  "statusLine": {
    "command": "bash ~/dotfiles/config/claude/statusline.sh",
    "type": "command"
  },
  "theme": "auto"
}